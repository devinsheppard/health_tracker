{
  "name": "my-health-tracker",
  "version": "2.1.0",
  "description": "Windows desktop personal health tracker",
  "main": "src/main.js",
  "author": "My Health Tracker",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "npm rebuild better-sqlite3 && node --test",
    "lint": "node scripts/lint.js",
    "format": "node scripts/format-check.js",
    "audit": "npm audit --audit-level=high",
    "build": "electron-builder install-app-deps && electron-builder --win nsis && node scripts/verify-packaged-native.js",
    "dist": "electron-builder install-app-deps && electron-builder && node scripts/verify-packaged-native.js",
    "make:icon": "node scripts/create-icon.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.4.9"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.myhealthtracker",
    "productName": "My Health Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "build/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Health Tracker",
      "uninstallDisplayName": "My Health Tracker"
    }
  }
}
